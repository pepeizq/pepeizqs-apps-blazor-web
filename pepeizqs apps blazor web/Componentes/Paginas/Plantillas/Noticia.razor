@page "/updates/{id:int}/{nombreNoticia?}/"

@using System.Text.RegularExpressions

@if (noticia != null)
{
    <TituloySEO titulo="@noticia.Titulo" descripcion="@noticia.Contenido" enlace="@noticiaEnlace" imagen="@ExtraerPrimeraImagen(noticia.Contenido)" />

    var bloques = Parsear(noticia.Contenido);

    <div style="margin-bottom: 50px;">
        <div style="display: flex; align-items: center; background-color: rgba(0,0,0,.4); margin-top: 40px; border-top-left-radius: 5px; border-top-right-radius: 5px;">
            <h1 class="noticia-titulo">@noticia.Titulo</h1>

            <div style="font-size: 17px; margin: 25px 30px 25px auto;">
                @noticia.Fecha.ToString("dd/MM/yyyy")
            </div>
        </div>
        
        @if (bloques.Count > 0)
        {
            <div style="display: flex; flex-direction: column; gap: 30px;">
                @foreach (var bloque in bloques)
                {
                    switch (bloque.Tipo)
                    {
                        case TipoBloque.Imagen:
                            if (bloque.Lineas.Count == 1)
                            {
                                <a href="@bloque.Lineas[0]" target="_blank" rel="noopener noreferrer" class="noticia-imagen-enlace" style="margin: 0px 30px; width: fit-content; max-width: 60%; background-color: rgba(0,0,0,.2); border: 1px solid rgba(0,0,0,.2); padding: 5px; border-radius: 5px;">
                                    <img src="@bloque.Lineas[0]" alt="@noticia.Titulo" loading="lazy" style="max-width: 100%; border-radius: 5px;" />
                                </a>
                            }
                            else
                            {
                                <div class="noticia-galeria">
                                    @foreach (var imagen in bloque.Lineas)
                                    {
                                        <a href="@imagen" target="_blank" rel="noopener noreferrer" class="noticia-imagen-enlace">
                                            <img src="@imagen" alt="@noticia.Titulo" loading="lazy" style="max-width: 100%;" />
                                        </a>
                                    }
                                </div>
                            }
                            break;

                        case TipoBloque.Lista:
                            <div class="noticia-div">
                                <ul class="noticia-ul">
                                    @foreach (var item in bloque.Lineas)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </div>
                            break;

                        default:
                            <div class="noticia-div">@Herramientas.AñadirEnlaces.Enlazar(bloque.Lineas[0])</div>
                            break;
                    }
                }
            </div>
        }
    </div>

    @if (noticiaAnterior != null || noticiaSiguiente != null)
    {
        <div style="padding: 30px; display: flex; align-items: center; gap: 40px; background-color: rgba(0,0,0,.2); border: 2px solid rgba(0,0,0,. 3); border-width: 2px 2px 0 2px; border-top-left-radius: 5px; border-top-right-radius: 5px;">
            @if (noticiaAnterior?.Id > 0)
            {
                string enlaceAnterior = "/updates/" + noticiaAnterior.Id + "/" + Herramientas.EnlaceAdaptador.Nombre(noticiaAnterior.Titulo) + "/";

                <a href="@enlaceAnterior" class="noticia-boton" style="justify-content: flex-end;">
                    <div style="width: 22px;">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                            <path fill="var(--colorTexto)" d="M73.4 297.4C60.9 309.9 60.9 330.2 73.4 342.7L233.4 502.7C245.9 515.2 266.2 515.2 278.7 502.7C291.2 490.2 291.2 469.9 278.7 457.4L173.3 352L544 352C561.7 352 576 337.7 576 320C576 302.3 561.7 288 544 288L173.3 288L278.7 182.6C291.2 170.1 291.2 149.8 278.7 137.3C266.2 124.8 245.9 124.8 233.4 137.3L73.4 297.3z" />
                        </svg>
                    </div>

                    @noticiaAnterior.Titulo
                </a>
            }

            @if (noticiaSiguiente?.Id > 0)
            {
                string enlaceSiguiente = "/updates/" + noticiaSiguiente.Id + "/" + Herramientas.EnlaceAdaptador.Nombre(noticiaSiguiente.Titulo) + "/";

                <a href="@enlaceSiguiente" class="noticia-boton" style="justify-content: flex-start;">
                    @noticiaSiguiente.Titulo

                    <div style="width: 22px;">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                            <path fill="var(--colorTexto)" d="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z" />
                        </svg>
                    </div>
                </a>
            }
        </div>
    }
}

@code {

    #nullable disable

    [Parameter]
    public int id { get; set; }

    [Parameter]
    public string nombreNoticia { get; set; }

    [PersistentState] public BaseDatos.Noticia noticia { get; set; }

    [PersistentState] public BaseDatos.Noticia noticiaAnterior { get; set; }
    [PersistentState] public BaseDatos.Noticia noticiaSiguiente { get; set; }

    public string noticiaEnlace = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarNoticia();
    }

    private async Task CargarNoticia()
    {
        if (id > 0)
        {
            noticia = await BaseDatos.Noticias.UnaNoticia(id);
            noticiaEnlace = "https://pepeizqapps.com/updates/" + id.ToString() + "/" + nombreNoticia;

            noticiaAnterior = await BaseDatos.Noticias.UnaNoticiaReducida(id - 1);
            noticiaSiguiente = await BaseDatos.Noticias.UnaNoticiaReducida(id + 1);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await CargarNoticia();
    }

    enum TipoBloque { Parrafo, Imagen, Lista }

    record Bloque(TipoBloque Tipo, List<string> Lineas);

    static readonly Regex regexImagen = new(@"^https?://\S+\.(png|jpe?g|gif|webp|avif)(\?\S*)?$", RegexOptions.IgnoreCase);
    static readonly Regex regexLista = new(@"^-+\s*(.+)$");
    static readonly Regex regexEnlace = new(@"^https?://\S+$", RegexOptions.IgnoreCase);

    static List<Bloque> Parsear(string contenido)
    {
        List<Bloque> bloques = new List<Bloque>();

        if (string.IsNullOrWhiteSpace(contenido) == true)
        {
            return bloques;
        }
        
        foreach (string linea in contenido.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            Match lista = regexLista.Match(linea);

            if (lista.Success == true)
            {
                if (bloques.Count > 0 && bloques[^1].Tipo == TipoBloque.Lista)
                {
                    bloques[^1].Lineas.Add(lista.Groups[1].Value);
                }
                else
                {
                    bloques.Add(new Bloque(TipoBloque.Lista, new List<string> { lista.Groups[1].Value }));
                }
            }
            else if (regexImagen.IsMatch(linea))
            {
                if (bloques.Count > 0 && bloques[^1].Tipo == TipoBloque.Imagen)
                {
                    bloques[^1].Lineas.Add(linea);
                }    
                else
                {
                    bloques.Add(new Bloque(TipoBloque.Imagen, new List<string> { linea }));
                }
            }
            else if (regexEnlace.IsMatch(linea) && bloques.Count > 0 && bloques[^1].Tipo == TipoBloque.Parrafo)
            {
                bloques[^1].Lineas[0] += Environment.NewLine + Environment.NewLine + linea;
            }
            else
            {
                bloques.Add(new Bloque(TipoBloque.Parrafo, new List<string> { linea }));
            }
        }

        return bloques;
    }

    static string ExtraerPrimeraImagen(string contenido)
    {
        if (string.IsNullOrWhiteSpace(contenido))
        {
            return null;
        }

        foreach (var linea in contenido.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (regexImagen.IsMatch(linea))
            {
                return linea;
            }
        }

        return null;
    }
}
