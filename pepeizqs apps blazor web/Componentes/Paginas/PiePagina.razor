<footer class="pie">
    <div class="cuerpo-ancho">
        <div class="pie-principal">
            <div class="pie-info">
                <div class="pie-marca">
                    <a href="https://pepeizqapps.com/" data-enhance-nav="false">pepeizq's apps</a>
                    <span>•</span>
                    <a href="https://pepe.deals/" target="_blank">pepe's deals</a>
                </div>

                <nav class="pie-enlaces">
                    <a href="/last-updates" target="_blank" data-enhance-nav="false">@Herramientas.Idiomas.BuscarTexto(idioma, "Title", "LastUpdates")</a>
                    <a href="/privacy" data-enhance-nav="false">@Herramientas.Idiomas.BuscarTexto(idioma, "Title", "Privacy")</a>
                    <a href="mailto:admin@pepe.deals">admin@pepe.deals</a>
                </nav>
            </div>

            <a href="https://github.com/pepeizq/" target="_blank" class="pie-github" title="Github">
                <div class="pie-github-cabecera">
                    <svg style="width: 32px; height: 32px; fill: var(--colorTexto);" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 496 512">
                        <path d="M165.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3 .3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6zm-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5 .3-6.2 2.3zm44.2-1.7c-2.9 .7-4.9 2.6-4.6 4.9 .3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9zM244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.3-14.3-112.3-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252 496 113.3 383.5 8 244.8 8zM97.2 352.9c-1.3 1-1 3.3 .7 5.2 1.6 1.6 3.9 2.3 5.2 1 1.3-1 1-3.3-.7-5.2-1.6-1.6-3.9-2.3-5.2-1zm-10.8-8.1c-.7 1.3 .3 2.9 2.3 3.9 1.6 1 3.6 .7 4.3-.7 .7-1.3-.3-2.9-2.3-3.9-2-.6-3.6-.3-4.3 .7zm32.4 35.6c-1.6 1.3-1 4.3 1.3 6.2 2.3 2.3 5.2 2.6 6.5 1 1.3-1.3 .7-4.3-1.3-6.2-2.2-2.3-5.2-2.6-6.5-1zm-11.4-14.7c-1.6 1-1.6 3.6 0 5.9 1.6 2.3 4.3 3.3 5.6 2.3 1.6-1.3 1.6-3.9 0-6.2-1.4-2.3-4-3.3-5.6-2z" />
                    </svg>
                    <div>
                        <div class="pie-github-titulo">@Herramientas.Idiomas.BuscarTexto(idioma, "Github1", "Index")</div>
                        <div class="pie-github-subtitulo">@Herramientas.Idiomas.BuscarTexto(idioma, "Github2", "Index")</div>
                    </div>
                </div>

                <div class="pie-stats">
                    <div class="pie-stat" title="Stars">
                        <svg style="width: 16px; height: 16px; fill: var(--colorTexto); float:left" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><path d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z" /></svg>
                        <strong>@estrellasGithub</strong>
                    </div>
                    <div class="pie-stat" title="Forks">
                        <svg style="width: 16px; height: 16px; fill: var(--colorTexto);" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M80 104a24 24 0 1 0 0-48 24 24 0 1 0 0 48zm80-24c0 32.8-19.7 61-48 73.3l0 38.7c0 17.7 14.3 32 32 32l160 0c17.7 0 32-14.3 32-32l0-38.7C307.7 141 288 112.8 288 80c0-44.2 35.8-80 80-80s80 35.8 80 80c0 32.8-19.7 61-48 73.3l0 38.7c0 53-43 96-96 96l-48 0 0 70.7c28.3 12.3 48 40.5 48 73.3c0 44.2-35.8 80-80 80s-80-35.8-80-80c0-32.8 19.7-61 48-73.3l0-70.7-48 0c-53 0-96-43-96-96l0-38.7C19.7 141 0 112.8 0 80C0 35.8 35.8 0 80 0s80 35.8 80 80zm208 24a24 24 0 1 0 0-48 24 24 0 1 0 0 48zM248 432a24 24 0 1 0 -48 0 24 24 0 1 0 48 0z" /></svg>
                        <strong>@forksGithub</strong>
                    </div>
                    <div class="pie-stat" title="Watchers">
                        <svg style="width: 16px; height: 16px; fill: var(--colorTexto);" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><path d="M288 32c-80.8 0-145.5 36.8-192.6 80.6C48.6 156 17.3 208 2.5 243.7c-3.3 7.9-3.3 16.7 0 24.6C17.3 304 48.6 356 95.4 399.4C142.5 443.2 207.2 480 288 480s145.5-36.8 192.6-80.6c46.8-43.5 78.1-95.4 93-131.1c3.3-7.9 3.3-16.7 0-24.6c-14.9-35.7-46.2-87.7-93-131.1C433.5 68.8 368.8 32 288 32zM144 256a144 144 0 1 1 288 0 144 144 0 1 1 -288 0zm144-64c0 35.3-28.7 64-64 64c-7.1 0-13.9-1.2-20.3-3.3c-5.5-1.8-11.9 1.6-11.7 7.4c.3 6.9 1.3 13.8 3.2 20.7c13.7 51.2 66.4 81.6 117.6 67.9s81.6-66.4 67.9-117.6c-11.1-41.5-47.8-69.4-88.6-71.1c-5.8-.2-9.2 6.1-7.4 11.7c2.1 6.4 3.3 13.2 3.3 20.3z" /></svg>
                        <strong>@suscriptoresGithub</strong>
                    </div>
                </div>
            </a>
        </div>

        <div class="pie-abajo">
            <span>&copy; @DateTime.Now.Year • pepeizq</span>

            <button class="pie-subir" onclick="moverScroll('cuerpazo')" title="Up">
                <svg style="width: 24px; height: 24px; fill: var(--colorEnlace);" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M233.4 105.4c12.5-12.5 32.8-12.5 45.3 0l192 192c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L256 173.3 86.6 342.6c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3l192-192z" /></svg>
            </button>
        </div>
    </div>
</footer>

@code {

    #nullable disable

    [Parameter]
    public string idioma { get; set; } = "en";

    public int estrellasGithub = 0;
    public int forksGithub = 0;
    public int suscriptoresGithub = 0;

    protected override async Task OnInitializedAsync()
    {
        List<global::BaseDatos.GithubBaseDatos> bdGithub = BaseDatos.Github.Todo();

        if (bdGithub?.Count > 0)
        {
            foreach (var entrada in bdGithub)
            {
                estrellasGithub = estrellasGithub + entrada.Estrellas;
                forksGithub = forksGithub + entrada.Forks;
                suscriptoresGithub = suscriptoresGithub + entrada.Suscriptores;
            }
        }
    }
}
