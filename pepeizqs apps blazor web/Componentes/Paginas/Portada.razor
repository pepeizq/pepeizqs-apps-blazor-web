@page "/"

@rendermode InteractiveServer

@using Herramientas
@using Microsoft.AspNetCore.Components.Web
@using Listados

@inject IHttpContextAccessor Contexto

@{
	string descripcion = Herramientas.Idiomas.BuscarTexto(idioma, "Subtitle", "Index");
	string titulo = "pepeizq's apps • " + descripcion;
	string enlace = "https://pepeizqapps.com/";
	string imagen = "https://pepeizqapps.com/imagenes/pepeizqapps/logo.png";
	string keywords = "source code";

	if (string.IsNullOrEmpty(descripcion) == false)
	{
		string[] keywordsEnBruto = Herramientas.Buscador.LimpiarNombre(titulo, false).Split(' ');
		List<string> keywordsLista = new List<string>();
		keywordsLista.AddRange(keywordsEnBruto);

		foreach (string keyword in keywordsLista)
		{
			if (keyword.Length > 3 && keywords.Contains(keyword) == false)
			{
				keywords = keywords + ", " + keyword;
			}
		}
	}

	<HeadContent>
		<PageTitle>@titulo</PageTitle>

		<meta name="og:title" Content="@titulo" />
		<meta name="description" content="@descripcion" />
		<meta name="og:description" content="@descripcion" />
		<meta name="og:url" content="@enlace" />
		<meta name="og:image" content="@imagen" />
		<meta name="og:site_name" content="pepeizq's apps" />
		<meta name="og:type" content="website" />
		<meta name="robots" content="index, follow" />
		<meta name="keywords" content="@keywords" />

		<script type="application/ld+json">
			{
			  "@@context": "https://schema.org",
			  "@@type": "BreadcrumbList",
			  "itemListElement": [{
				"@@type": "ListItem",
				"position": 1,
				"name": "Last Updates",
				"item": "https://pepeizqapps.com/last-updates"
			  }]
			}
		</script>

		<script type="application/ld+json">
			{
			  "@@context": "https://schema.org",
			  "@@type": "Organization",
			  "name": "pepeizq's apps",
			  "description": "@descripcion",
			  "url": "@enlace",
			  "logo": {
				"@@type": "ImageObject",
				"url": "@imagen",
				"caption": "pepeizq's apps logo"
			  },
			  "contactPoint": {
				"@@type": "ContactPoint",
				"email": "admin@pepe.deals",
				"areaServed": "Worldwide",
				"availableLanguage": "Spanish, English"
			  },
			  "sameAs": [
				  "https://github.com/pepeizq/"
			  ]
			}
		</script>
	</HeadContent>
}

<div style="display: flex; flex-direction: column; gap: 60px; padding: 40px 0;">
	@if (proyectosActivos?.Count > 0)
	{
		<div style="background-color: rgba(0,0,0,.3); border-radius: 5px; overflow: hidden; color: var(--colorTexto); font-size: 16px; margin-bottom: 40px;">
			<div style="padding: 20px 30px; font-size: 20px; display: flex; align-items: center; gap: 20px; background: linear-gradient(270deg, #002033 0%, rgba(0,0,0,.2) 30%);">
				<div>
					pepe's deals
				</div>
				
				<div style="margin-left: auto;">
					<img src="@Herramientas.Imagenes.ServidorExterno("/imagenes/" + proyectosActivos[0].Id + "/logo.webp", 30, 30)" alt="logo" style="width: 30px; height: 30px; border-radius: 5px;" />
				</div>
			</div>

			<div style="padding: 30px;">
				<h2 style="font-size: 16px; line-height: 26px;">
					@Idiomas.BuscarTexto(idioma, "String1", "Index")
				</h2>

				<div class="rejilla-activos" style="margin-top: 30px;">
					@foreach (var proyecto in proyectosActivos)
					{
						string captura = "1";

						if (proyecto.Secciones?.Count > 0)
						{
							captura = proyecto.Secciones[0].Captura;
						}

						<a href="@proyecto.Ubicacion" data-enhance-nav="false" class="tarjeta-proyecto tarjeta-grande" style="--acento: @proyecto.Color1;">
							<img class="captura" src="@Herramientas.Imagenes.ServidorExterno("/imagenes/" + proyecto.Id + "/captura" + captura + ".webp", 400, 180)" alt="screenshot" />

							<div class="tarjeta-descripcion" style="padding: 15px;">@Idiomas.BuscarTexto(idioma, "String1", proyecto.Id)</div>
						
							@if (proyecto.Tipo == ProyectoTipo.App)
							{
								<div class="tarjeta-icono-posicion tarjeta-icono-estilo">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="margin: 3px;">
										<path fill="rgba(255,255,255,0.6)" d="M96 157.7L279.6 132.4L279.6 309.8L96 309.8L96 157.7zM96 482.3L279.6 507.6L279.6 332.4L96 332.4L96 482.3zM299.8 510.3L544 544L544 332.4L299.8 332.4L299.8 510.3zM299.8 129.7L299.8 309.8L544 309.8L544 96L299.8 129.7z" />
									</svg>
								</div>
							}
							else if (proyecto.Tipo == ProyectoTipo.Web)
							{
								<div class="tarjeta-icono-posicion tarjeta-icono-estilo">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="margin: 3px;">
										<path fill="rgba(255,255,255,0.6)" d="M415.9 344L225 344C227.9 408.5 242.2 467.9 262.5 511.4C273.9 535.9 286.2 553.2 297.6 563.8C308.8 574.3 316.5 576 320.5 576C324.5 576 332.2 574.3 343.4 563.8C354.8 553.2 367.1 535.8 378.5 511.4C398.8 467.9 413.1 408.5 416 344zM224.9 296L415.8 296C413 231.5 398.7 172.1 378.4 128.6C367 104.2 354.7 86.8 343.3 76.2C332.1 65.7 324.4 64 320.4 64C316.4 64 308.7 65.7 297.5 76.2C286.1 86.8 273.8 104.2 262.4 128.6C242.1 172.1 227.8 231.5 224.9 296zM176.9 296C180.4 210.4 202.5 130.9 234.8 78.7C142.7 111.3 74.9 195.2 65.5 296L176.9 296zM65.5 344C74.9 444.8 142.7 528.7 234.8 561.3C202.5 509.1 180.4 429.6 176.9 344L65.5 344zM463.9 344C460.4 429.6 438.3 509.1 406 561.3C498.1 528.6 565.9 444.8 575.3 344L463.9 344zM575.3 296C565.9 195.2 498.1 111.3 406 78.7C438.3 130.9 460.4 210.4 463.9 296L575.3 296z" />
									</svg>
								</div>
							}
							else if (proyecto.Tipo == ProyectoTipo.Complemento)
							{
								<div class="tarjeta-icono-posicion" style="display: flex; align-items: center; gap: 10px;">
									<div class="tarjeta-icono-estilo">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="margin: 3px;">
											<path fill="rgba(255,255,255,0.6)" d="M64 320C64 273.4 76.5 229.6 98.3 191.1L208.1 382.3C230 421.5 271.9 448 320 448C334.3 448 347.1 445.7 360.8 441.4L284.5 573.6C159.9 556.3 64 449.3 64 320zM429.1 385.6C441.4 366.4 448 343.1 448 320C448 281.8 431.2 247.5 404.7 224L557.4 224C569.4 253.6 576 286.1 576 320C576 461.4 461.4 575.1 320 576L429.1 385.6zM541.8 192L320 192C257.1 192 206.3 236.1 194.5 294.7L118.2 162.5C165 102.5 238 64 320 64C414.8 64 497.5 115.5 541.8 192zM408 320C408 368.6 368.6 408 320 408C271.4 408 232 368.6 232 320C232 271.4 271.4 232 320 232C368.6 232 408 271.4 408 320z" />
										</svg>
									</div>

									<div class="tarjeta-icono-estilo">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="margin: 3px;">
											<path fill="rgba(255,255,255,0.6)" d="M194.2 191.5L194.2 191.5zM545.6 236.9C535 211.4 513.5 183.9 496.7 175.2C510.4 202.1 518.4 229.1 521.4 249.2C521.4 249.3 521.4 249.5 521.5 249.6C493.9 180.8 447.1 153.1 408.9 92.8C393.9 69.1 398 67.6 395.8 68.1L395.7 68.2C349 94.2 320.4 146.6 313.1 190.9C296.5 191.8 280.2 195.9 265.2 203C263.8 203.6 262.7 204.7 262.1 206C261.5 207.3 261.2 208.8 261.5 210.3C261.7 211.1 262.1 211.9 262.6 212.6C263.1 213.3 263.8 213.9 264.5 214.3C265.2 214.7 266.1 215 266.9 215.1C267.7 215.2 268.6 215.1 269.4 214.8L269.9 214.6C285.4 207.3 302.3 203.4 319.4 203.3C382.2 202.7 416.6 247.3 427 265.6C414 256.4 390.6 247.4 368.2 251.3C455.9 295.2 432.4 445.8 310.8 440.5C251.3 437.9 213.7 389.5 210.3 349.7C210.3 349.7 221.5 307.8 290.9 307.8C298.4 307.8 319.8 286.9 320.2 280.8C320.1 278.8 277.7 261.9 261.1 245.6C252.3 236.9 248 232.7 244.3 229.5C242.3 227.8 240.2 226.2 238 224.7C232.4 205.2 232.2 184.7 237.3 165.1C212.2 176.5 192.7 194.5 178.6 210.5L178.5 210.5C168.8 198.3 169.5 157.9 170.1 149.4C170 148.9 162.9 153.1 161.9 153.7C153.3 159.8 145.4 166.6 138.1 174.1C121.8 190.7 94 224.3 82.6 275.3C78.1 295.7 75.8 319.7 75.8 327.6C75.8 462.3 185 571.5 319.7 571.5C440.3 571.5 542.7 484.3 560.1 368.9C571.7 292.2 545.4 237.8 545.4 236.9z" />
										</svg>
									</div>

									<div class="tarjeta-icono-estilo">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="margin: 3px;">
											<path fill="rgba(255,255,255,0.6)" d="M184.1 101.4C225.1 76.2 271.7 63.2 319 64C487 64 576 187.8 576 283.5C575.9 316.2 563 347.4 540.1 370.7C517.2 393.9 486.1 407.2 453.4 407.7C378.2 407.7 361.9 384.6 361.9 375.7C361.9 371.9 363.1 369.5 366.7 366.3L367.7 365.1L368.1 363.5C378.6 352 384 337.3 384 321.9C384 243.2 301.8 179.2 200 179.2C162.5 178.9 125.5 188.1 92.5 206.1C119.5 148.6 175.2 108.5 183.8 102.3C184.6 101.7 184.1 101.5 184.1 101.5zM199.7 419.5C198.3 449.5 204.3 479.5 216.1 506.7C229.7 533.1 248.8 557.7 272.6 576C213.1 564.5 161.1 532.1 123.2 486.7C85.1 440.3 64 382.4 64 321.9C64 270.7 126.4 227.5 200 227.5C236.6 226.9 272.4 238.4 301.8 260.2L298.2 261.4C246.7 279 199.7 352.1 199.7 419.5zM533.8 464L533.1 464.1C521.3 482.9 507.2 499.2 490.9 513.6C460.1 541.6 422.8 559.1 382.1 563.5C363.5 563.8 345.3 560.3 328.3 552.1C302.7 541.8 281.2 522.1 266.7 499.1C252.3 475.2 245.6 447.4 247.7 419.5C247.1 399.4 253.1 379.2 262.7 361.3C276.6 394.4 300.2 422.6 330.3 442.1C360.4 461.6 395.8 471.6 431.7 470.7C462.7 471 493.8 464 521.9 450.2L523.8 449.3C527.7 447 531.5 445.4 535.4 449.3C539.9 454.2 537.2 458.5 534.2 463.3C534 463.5 533.9 463.8 533.8 464z" />
										</svg>
									</div>
								</div>
							}
						</a>
					}
				</div>

				<div style="margin-top: 30px; text-align: center;">
					<a href="/cost-pepedeals">
						@Idiomas.BuscarTexto(idioma, "String5", "Index")
					</a>
				</div>
			</div>
		</div>
	}

	@if (noticias?.Count > 0)
	{
		<div style="background-color: rgba(0,0,0,.3); border-radius: 5px; overflow: hidden; color: var(--colorTexto); font-size: 16px; margin-left: 40px; margin-right: 40px; margin-bottom: 40px;">
			<div style="padding: 20px 30px; font-size: 20px; background-color: rgba(0,0,0,.2);">
				@Idiomas.BuscarTexto(idioma, "String4", "Index")
			</div>

			<div style="padding: 30px; display: flex; flex-direction: column; gap: 30px;">
				@foreach (var noticia in noticias)
				{
					string enlaceNoticia = "updates/" + noticia.Id.ToString() + "/" + Herramientas.EnlaceAdaptador.Nombre(noticia.Titulo) + "/";
					string imagenNoticia = noticia.Imagen;

					if (string.IsNullOrEmpty(imagenNoticia) == true)
					{
						imagenNoticia = "https://pepeizqapps.com/imagenes/pepeizqapps/logo.webp";
					}

					<a href="@enlaceNoticia" data-enhance-nav="false" class="tarjeta-proyecto tarjeta-compacta">
						<div style="display: flex; align-items: center; gap: 30px;">
							<img class="captura" style="width: fit-content; max-width: 100px; object-fit: contain; background-color: rgba(0,0,0,.1); min-width: 100px;" src="@imagenNoticia" alt="screenshot" />

							<div style="font-size: 17px;">@noticia.Titulo</div>

							<div style="font-size: 15px; margin-left: auto; padding: 30px;">@noticia.Fecha.ToString("dd/MM/yyyy")</div>
						</div>
					</a>
				}
			</div>
		</div>
	}

	@if (proyectosParados?.Count > 0)
	{
		<div style="background-color: rgba(0,0,0,.3); border-radius: 5px; overflow: hidden; color: var(--colorTexto); font-size: 16px;">
			<div style="padding: 20px 30px; font-size: 20px; background-color: rgba(0,0,0,.2);">
				@Idiomas.BuscarTexto(idioma, "String2", "Index")
			</div>

			<div style="padding: 30px;">
				<div>
					@Idiomas.BuscarTexto(idioma, "String3", "Index")
				</div>

				<div style="display: flex; flex-wrap: wrap; gap: 15px; margin-top: 30px; margin-bottom: 30px;">
					<button class="chip @(tipoSeleccionado == "Todos" ? "activo" : "")" @onclick="@(e => CambiarProyectos(e))">
						@Idiomas.BuscarTexto(idioma, "All", "Index") (@Listados.Proyectos.DevolverProyectosParados().Count)
					</button>

					@foreach (var (tipo, clave) in tiposFiltro)
					{
						if (LeerProyectos(tipo) > 0)
						{
							<button class="chip @(tipoSeleccionado == tipo.ToString() ? "activo" : "")" @onclick="@(e => CambiarProyectos(e, tipo))">
								@Idiomas.BuscarTexto(idioma, clave, "Index") (@LeerProyectos(tipo))
							</button>
						}
					}

					@foreach (var tecnologia in tecnologias)
					{
						if (LeerProyectos(tecnologia.Id) > 0)
						{
							<button class="chip @(tipoSeleccionado == tecnologia.Id.ToString() ? "activo" : "")" @onclick="@(e => CambiarProyectos(e, tecnologia.Id))" title="@tecnologia.Nombre">
								<img src="/imagenes/tecnologias/@tecnologia.Imagen" style="max-height: 18px; object-fit: contain;" alt="@tecnologia.Nombre" />
							
								@if (tecnologia.MostrarNombre == true)
								{
									<span>@tecnologia.Nombre</span>
								}

								<span>(@LeerProyectos(tecnologia.Id))</span>
							</button>
						}
					}
				</div>

				<div class="rejilla-parados">
					@foreach (var proyecto in proyectosParados)
					{
						string enlaceProyecto = string.IsNullOrEmpty(proyecto.Ubicacion) && !string.IsNullOrEmpty(proyecto.Github)
							? "https://github.com/pepeizq/" + proyecto.Github + "/"
							: proyecto.Ubicacion;

						<a href="@enlaceProyecto" data-enhance-nav="false" class="tarjeta-proyecto tarjeta-compacta" style="--acento: @proyecto.Color1;">
							<img class="captura" src="@Herramientas.Imagenes.ServidorExterno("/imagenes/" + proyecto.Id + "/captura1.webp", 297, 100)" alt="screenshot" />

							<div class="tarjeta-cabecera" style="background-color: rgba(0,0,0,.2);">
								<img src="@Herramientas.Imagenes.ServidorExterno("/imagenes/" + proyecto.Id + "/logo.webp", 40, 40)" alt="logo" />
								<div style="font-size: 16px;">@proyecto.Nombre</div>
							</div>

							<div class="tarjeta-descripcion" style="padding: 15px;">@Idiomas.BuscarTexto(idioma, "String1", proyecto.Id)</div>
						</a>
					}
				</div>
			</div>
		</div>
	}
</div>

@code {

	#nullable disable

	private string idioma = "en";

	[PersistentState] public List<Proyecto> proyectosActivos { get; set; }
	[PersistentState] public List<Proyecto> proyectosParados { get; set; }
	[PersistentState] public List<BaseDatos.Noticia> noticias { get; set; }

	private List<Tecnologia> tecnologias = new List<Tecnologia>();

	private static readonly (ProyectoTipo, string)[] tiposFiltro =
	{
		(ProyectoTipo.App, "App"),
		(ProyectoTipo.Web, "Web"),
		(ProyectoTipo.Juego, "Game"),
		(ProyectoTipo.Complemento, "Extension")
	};

	private string tipoSeleccionado = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		idioma = Contexto?.HttpContext?.Request?.Headers["Accept-Language"].ToString().Split(";").FirstOrDefault()?.Split(",").FirstOrDefault();

		tipoSeleccionado = "Todos";
		tecnologias = Listados.Tecnologias.Generar();

		if (tecnologias?.Count > 0)
		{
			tecnologias = tecnologias.OrderBy(x => x.Nombre).ToList();
		}

		proyectosActivos ??= Listados.Proyectos.DevolverProyectosActivos();
		proyectosParados ??= Listados.Proyectos.DevolverProyectosParados(true);
		noticias ??= await BaseDatos.Noticias.UltimasReducida(5);
	}

	private void CambiarProyectos(MouseEventArgs e)
	{
		tipoSeleccionado = "Todos";
		proyectosParados = Listados.Proyectos.DevolverProyectosParados();
	}

	private void CambiarProyectos(MouseEventArgs e, ProyectoTipo tipo)
	{
		tipoSeleccionado = tipo.ToString();
		proyectosParados = Listados.Proyectos.DevolverProyectos(tipo, ProyectoEstado.Parado);
	}

	private void CambiarProyectos(MouseEventArgs e, TecnologiaTipo tipo)
	{
		tipoSeleccionado = tipo.ToString();
		proyectosParados = Listados.Proyectos.DevolverProyectos(tipo, ProyectoEstado.Parado);
	}

	private int LeerProyectos(ProyectoTipo tipo)
	{
		return Listados.Proyectos.DevolverProyectos(tipo, ProyectoEstado.Parado).Count;
	}

	private int LeerProyectos(TecnologiaTipo tipo)
	{
		return Listados.Proyectos.DevolverProyectos(tipo, ProyectoEstado.Parado).Count;
	}
}
