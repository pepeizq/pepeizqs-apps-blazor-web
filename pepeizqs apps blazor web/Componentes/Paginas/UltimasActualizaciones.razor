@page "/last-updates/"

@using Microsoft.AspNetCore.Components.Web
@using System.Text.RegularExpressions

@inject IHttpContextAccessor Contexto

<TituloySEO titulo="@Herramientas.Idiomas.BuscarTexto(idioma, "Title", "LastUpdates")" descripcion="@Herramientas.Idiomas.BuscarTexto(idioma, "String2", "LastUpdates")" enlace="https://pepeizqapps.com/last-updates" />

<div style="padding: 50px; border-radius: 5px; overflow: hidden;">
    <div style="font-size: 22px; padding: 20px 30px; background-color: rgba(0,0,0,.4); border-top-left-radius: inherit; border-top-right-radius: inherit;">
		@Herramientas.Idiomas.BuscarTexto(idioma, "Title", "LastUpdates")
    </div>

	<div style="background-color: var(--fondoEntrada); padding: 30px; border-bottom-left-radius: inherit; border-bottom-right-radius: inherit; display: flex; flex-direction: column; gap: 30px;">
		@if (noticias?.Count > 0)
		{
			foreach (var noticia in noticias)
			{
				string enlaceNoticia = "updates/" + noticia.Id.ToString() + "/" + Herramientas.EnlaceAdaptador.Nombre(noticia.Titulo) + "/";
				string imagenNoticia = noticia.Imagen;
				string entradillaNoticia = Entradilla(noticia.Contenido);

				if (string.IsNullOrEmpty(imagenNoticia) == true)
				{
					imagenNoticia = "https://pepeizqapps.com/imagenes/pepeizqapps/logo.webp";
				}

				<a href="@enlaceNoticia" data-enhance-nav="false" class="tarjeta-proyecto tarjeta-compacta">
					<div style="display: flex; align-items: center;">
						<img style="min-width: 200px; height: 150px; object-fit: contain; background-color: rgba(0,0,0,.1);" src="@imagenNoticia" alt="screenshot" />

						<div style="padding: 20px; display: flex; flex-direction: column; gap: 20px;">
							<div style="display: flex; align-items: center; gap: 30px;">
								<div style="font-size: 18px;">@noticia.Titulo</div>

								<div style="font-size: 16px; margin-left: auto;">@noticia.Fecha.ToString("dd/MM/yyyy")</div>
							</div>

							@if (string.IsNullOrEmpty(entradillaNoticia) == false)
							{
								<div style="font-size: 15px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
									@entradillaNoticia
								</div>
							}
						</div>						
					</div>
				</a>
			}
		}
	</div>
</div>

@code {

    #nullable disable

    [Parameter]
    public string idioma { get; set; }

	[PersistentState] public List<BaseDatos.Noticia> noticias { get; set; }

	protected override async Task OnInitializedAsync()
    {
		idioma = Contexto?.HttpContext?.Request?.Headers["Accept-Language"].ToString().Split(";").FirstOrDefault()?.Split(",").FirstOrDefault();

		noticias ??= await BaseDatos.Noticias.Ultimas(10);
	}

	static readonly Regex regexImagen = new(@"^https?://\S+\.(png|jpe?g|gif|webp|avif)(\?\S*)?$", RegexOptions.IgnoreCase);
	static readonly Regex regexLista = new(@"^-+\s*(.+)$");

	static string Entradilla(string contenido, int maximo = 900)
	{
		if (string.IsNullOrWhiteSpace(contenido))
		{
			return null;
		}

		foreach (string linea in contenido.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
		{
			if (regexLista.IsMatch(linea) || regexImagen.IsMatch(linea))
			{
				continue;
			}

			if (linea.Length <= maximo)
			{
				return linea;
			}

			return linea.Substring(0, maximo).TrimEnd() + "…";
		}

		return null;
	}
}
