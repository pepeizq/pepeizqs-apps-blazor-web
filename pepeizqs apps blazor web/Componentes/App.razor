@using pepeizqs_apps_blazor_web.Componentes.Paginas

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <base href="/" />

    <link rel="stylesheet" href="@Assets["/css/bundle.css"]" type="text/css" media="print" onload="this.media='all'" />

    @* CSS en componentes razor *@
    <link rel="preload" href="/@Assets["pepeizqs_apps_blazor_web.styles.css"]" as="style" onload="this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="/@Assets["pepeizqs_apps_blazor_web.styles.css"]" /></noscript>

    <link rel="apple-touch-icon" sizes="152x152" href="/favicons/apple-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-icon-180x180.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicons/android-icon-192x192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicons/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="msapplication-TileColor" content="#007272" />
    <meta name="msapplication-TileImage" content="/favicons/ms-icon-144x144.png" />
    <meta name="theme-color" content="#007272" />

    <link rel="canonical" href="@enlace" />

    <HeadOutlet />
    <ImportMap />
</head>

<body class="cuerpo" style="margin: 0px;">
    <header style="height: var(--alturaCabecera); background-color: var(--fondoOscuro); z-index: 9999; position: sticky; top: 0; padding: 15px;">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm" style="padding: 0px;">
            <div class="cabecera-poner cuerpo-ancho" style="justify-content: start; display: flex; align-items: center;">
                <a class="texto-logo" href="/" data-enhance-nav="false">pepeizq's apps</a>

                <Buscador idioma="@idioma"/>

                <div style="flex: 1; display: flex; align-items: center; justify-content: right; font-size: 25px; text-align: right;">
                    <div style="margin-left: 6px; margin-right: 6px;">
                        <a href="/rss/updates.xml" target="_blank" title="RSS">
                            <svg class="cabecera-icono" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                <path d="M96 128C96 110.3 110.3 96 128 96C357.8 96 544 282.2 544 512C544 529.7 529.7 544 512 544C494.3 544 480 529.7 480 512C480 317.6 322.4 160 128 160C110.3 160 96 145.7 96 128zM96 480C96 444.7 124.7 416 160 416C195.3 416 224 444.7 224 480C224 515.3 195.3 544 160 544C124.7 544 96 515.3 96 480zM128 224C287.1 224 416 352.9 416 512C416 529.7 401.7 544 384 544C366.3 544 352 529.7 352 512C352 388.3 251.7 288 128 288C110.3 288 96 273.7 96 256C96 238.3 110.3 224 128 224z" />
                            </svg>
                        </a>
                    </div>
                    
                    <div style="margin-left: 6px; margin-right: 6px;">
                        <a href="@github" target="_blank" title="Github">
                            <svg class="cabecera-icono" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                <path d="M280.5 426.5C214.5 418.5 168 371 168 309.5C168 284.5 177 257.5 192 239.5C185.5 223 186.5 188 194 173.5C214 171 241 181.5 257 196C276 190 296 187 320.5 187C345 187 365 190 383 195.5C398.5 181.5 426 171 446 173.5C453 187 454 222 447.5 239C463.5 258 472 283.5 472 309.5C472 371 425.5 417.5 358.5 426C375.5 437 387 461 387 488.5L387 540.5C387 555.5 399.5 564 414.5 558C505 523.5 576 433 576 321C576 179.5 461 64 319.5 64C178 64 64 179.5 64 321C64 432 134.5 524 229.5 558.5C243 563.5 256 554.5 256 541L256 501C249 504 240 506 232 506C199 506 179.5 488 165.5 454.5C160 441 154 433 142.5 431.5C136.5 431 134.5 428.5 134.5 425.5C134.5 419.5 144.5 415 154.5 415C169 415 181.5 424 194.5 442.5C204.5 457 215 463.5 227.5 463.5C240 463.5 248 459 259.5 447.5C268 439 274.5 431.5 280.5 426.5z" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="cuerpazo" role="main" class="cuerpo-ancho">
        <Routes />
    </main>

    <PiePagina idioma="@idioma"/>

    <script async src="~/superjs.js"></script>

    @if (Herramientas.Bots.UserAgentEsBot(userAgent) == false)
    {
        <div id="reconnect-modal" style="display: none;"></div>
        <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
        <script src="@Assets["Inicio.js"]"></script>
    }

    <script>
        function moverScroll(id) {
            const element = document.getElementById(id);
            const y = element.getBoundingClientRect().top;

            window.scrollTo({ top: y, behavior: 'smooth' });
        }
    </script>
</body>

</html>

@code {

    #nullable disable

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string enlace = null;
    private string idioma = "en";
    private string userAgent = null;
    private string github = "https://github.com/pepeizq/";

    protected override void OnInitialized()
    {
        if (HttpContext != null)
        {
            idioma = HttpContext?.Request?.Headers["Accept-Language"].ToString().Split(";").FirstOrDefault()?.Split(",").FirstOrDefault();
            userAgent = HttpContext?.Request?.Headers.UserAgent.ToString();

            var path = HttpContext?.Request?.Path.ToString();
            enlace = "https://pepeizqapps.com" + path;
        }
    }
}